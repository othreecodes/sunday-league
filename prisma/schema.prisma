generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  phoneNumber    String?
  role           Role          @default(MEMBER)
  isActive       Boolean       @default(true)
  isSuspended    Boolean       @default(false)
  suspendedUntil DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  nickname       String?       @unique
  cardsReceived  Card[]
  assists        Goal[]        @relation("GoalAssist")
  goalsScored    Goal[]        @relation("GoalScorer")
  groupMembers   GroupMember[]
  matchPlayers   MatchPlayer[]
}

model Season {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  groups    Group[]
  matches   Match[]
}

model Group {
  id          String        @id @default(cuid())
  name        String
  seasonId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  season      Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  awayMatches Match[]       @relation("AwayGroup")
  homeMatches Match[]       @relation("HomeGroup")
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Match {
  id          String        @id @default(cuid())
  seasonId    String
  homeGroupId String
  awayGroupId String
  homeScore   Int           @default(0)
  awayScore   Int           @default(0)
  matchDate   DateTime
  location    String?
  status      MatchStatus   @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cards       Card[]
  goals       Goal[]
  awayGroup   Group         @relation("AwayGroup", fields: [awayGroupId], references: [id])
  homeGroup   Group         @relation("HomeGroup", fields: [homeGroupId], references: [id])
  season      Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  players     MatchPlayer[]
}

model MatchPlayer {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  groupId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Goal {
  id        String   @id @default(cuid())
  matchId   String
  scorerId  String
  assistId  String?
  minute    Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assist    User?    @relation("GoalAssist", fields: [assistId], references: [id])
  scorer    User     @relation("GoalScorer", fields: [scorerId], references: [id])
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Card {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  cardType  CardType
  minute    Int?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Settings {
  id               String   @id @default(cuid())
  leagueName       String   @default("Cowrywise FC")
  matchesPerSeason Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Role {
  ADMIN
  REFEREE
  MEMBER
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CardType {
  YELLOW
  RED
}
